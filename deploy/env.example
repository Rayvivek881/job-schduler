# ============================================================================
# Job Scheduler Environment Configuration
# ============================================================================
# Copy this file to .env in the project root and update with your actual values
# cp deploy/env.example .env

# ============================================================================
# Application Configuration
# ============================================================================
APP_ENV=development
# Options: development, staging, production

API_KEY=your-secret-api-key-change-me
# Required: API key for authenticating API requests
# Generate a strong random key for production

MAX_REQUESTS_PER_MINUTE=1000
# Optional: Rate limit for API requests (default: 1000)
# Production recommendation: 5000+

# ============================================================================
# PostgreSQL Configuration
# ============================================================================
PG_DB_HOST=localhost
# Required: PostgreSQL host address
# Examples: localhost, db.example.com, 10.0.0.5

PG_DB_PORT=5432
# Optional: PostgreSQL port (default: 5432)

PG_DB_DATABASE=job_scheduler
# Required: Database name

PG_DB_USERNAME=postgres
# Required: Database username

PG_DB_PASSWORD=postgres
# Required: Database password
# Use strong password in production and store securely

PG_DB_DEBUG=false
# Optional: Enable SQL query logging (default: false)
# Set to true for development debugging

PG_DB_SSL=false
# Optional: Enable SSL/TLS connection (default: false)
# Set to true for production connections

# ============================================================================
# Kafka Configuration
# ============================================================================
KAFKA_BROKERS=localhost:9092
# Required: Kafka broker addresses (comma-separated for multiple brokers)
# Examples: 
#   Single: localhost:9092
#   Multiple: kafka1:9092,kafka2:9092,kafka3:9092

KAFKA_VERSION=3.6.0
# Required: Kafka version (must match your Kafka cluster version)

KAFKA_USERNAME=
# Optional: Kafka SASL username (leave empty if not using SASL)
# Required if using SASL authentication

KAFKA_PASSWORD=
# Optional: Kafka SASL password (leave empty if not using SASL)
# Required if using SASL authentication

KAFKA_SASL_MECHANISM=
# Optional: SASL mechanism (PLAIN, SCRAM-SHA-256, SCRAM-SHA-512)
# Examples: PLAIN, SCRAM-SHA-256

JOBS_TOPIC=jobs-topic
# Required: Kafka topic name for jobs
# Create this topic before deploying consumers

CONSUMER_GROUP=jobs-consumer-group
# Required: Kafka consumer group name
# All consumer instances should use the same group name

# ============================================================================
# Job Configuration
# ============================================================================
TICKER_INTERVAL=1
# Optional: Scheduler tick interval in minutes (default: 1)
# How often the scheduler checks for ready jobs

JOB_EXECUTION_TIMEOUT=30
# Optional: Job execution timeout in minutes (default: 30)
# Jobs that exceed this timeout will be marked as failed

JOB_IN_QUEUE_SIZE=1000
# Optional: Maximum jobs in queue (currently not enforced)

PARALLEL_JOBS=10
# Optional: Maximum parallel jobs (currently not enforced)
